FLOATCHAT_DSN=postgresql://postgres:postgres@localhost:5432/floatchat
# Optional: enables the LLM tool-calling agent (any OpenAI-compatible API). Without it the deterministic planner is used.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1      # e.g. https://api.groq.com/openai/v1
# LLM_MODEL=gpt-4o                            # e.g. llama-3.3-70b-versatile
